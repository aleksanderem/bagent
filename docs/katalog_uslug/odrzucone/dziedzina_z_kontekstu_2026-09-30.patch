+async def _zapytaj_score(klasy: dict[str, dict], pytanie, plik: Path, budzet: float, proba: int, tok_na: int,
+                         pola: tuple[str, ...], nazwa: str) -> float:
+    """Wspólny przebieg pytań Score raz na klasę z pamięcią (dziedziny, jednoznaczność): nowe klasy od najczęstszych,
+    próba = N pierwszych, szacunek przed wywołaniem, brak odpowiedzi zapisany jawnie (= klasa nierozstrzygnięta)."""
+    from typesafe_sdk import AsyncTypeSafeClient
+    pamiec = json.loads(plik.read_text(encoding="utf-8")) if plik.exists() else {}
+    nowe = sorted((k for k in klasy if k not in pamiec), key=lambda k: -klasy[k]["par"])
+    nowe = nowe[:proba] if proba else nowe  # próba: najczęstsze klasy, obejrzane przed pełnym przebiegiem
+    szac = len(nowe) * tok_na * CENA_TOK
+    print(f"klas {nazwa} {len(klasy)}, nowych do pytania {len(nowe)}, szac. {szac:.4f} USD (budżet {budzet})", flush=True)
+    if szac > budzet:
+        sys.exit("szacunek ponad budżet — przerwane")
+    tok, sem = [0], asyncio.Semaphore(6)
+    async with AsyncTypeSafeClient(api_key=KLUCZ.read_text(encoding="utf-8").strip(), model=MODEL, timeout=60.0) as c:
+        async def jedna(k: str) -> None:
+            z = klasy[k]
+            opis = {x: z[x] for x in pola}
+            async with sem:
+                try:
+                    r = await c.system_one(z["stan"], {"s": pytanie(z)}, model=MODEL)
+                    tok[0] += r.usage.input_tokens or 0
+                    sc = r.scores["s"]
+                    pamiec[k] = {**opis, "score": sc.score, "rozklad": dict(sc.probabilities)}
+                except Exception as e:  # noqa: BLE001 — brak odpowiedzi = klasa nierozstrzygnięta, zapisane jawnie
+                    pamiec[k] = {**opis, "score": None, "blad": f"{type(e).__name__}: {str(e)[:120]}"}
+        await asyncio.gather(*(jedna(k) for k in nowe))
+    plik.parent.mkdir(parents=True, exist_ok=True)
+    plik.write_text(json.dumps(pamiec, ensure_ascii=False, indent=1), encoding="utf-8")
+    return tok[0] * CENA_TOK
+
