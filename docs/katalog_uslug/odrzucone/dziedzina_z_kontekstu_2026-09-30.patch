+        z.setdefault("kontekst_b", z["stan"]["oferta_b"]["kontekst"])
+    return await _zapytaj_score(dz, lambda z: pytanie_dziedziny(z["usluga"]), plik or PLIK_DZIEDZIN, budzet, proba, 600,
+                                ("klasa", "usluga", "a", "b", "kontekst_a", "kontekst_b"), "dziedziny")
+
