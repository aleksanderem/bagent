# MiniMax
MINIMAX_API_KEY=sk-cp-...
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3
# M3 ma okno kontekstu do 1M tokenów (server-side, tiered ≤512K / 512K–1M).
# Warstwa /anthropic raportuje 200K w metadanych (bug MiniMax-AI/MiniMax-M2.7#46),
# więc o duże okno prosimy nagłówkiem beta (services/minimax.py). false = wyłącz.
MINIMAX_1M_CONTEXT=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Convex (for webhook callbacks)
CONVEX_URL=https://your-project.convex.site
CONVEX_DEPLOY_KEY=

# Server
API_KEY=your-api-key-for-convex-auth
PORT=3001

# Healthchecks (self-hosted: https://healthchecks.booksyaudit.pl/)
# Worker-liveness heartbeats — ONE check per worker PROCESS. Each is pinged
# every 5 min; create the checks with a ~10 min grace window. Leaving a var
# unset is a safe no-op (the cron just skips the ping in local dev).
#   - scrape worker  (WorkerSettings / arq:queue)   → worker_heartbeat
#   - report worker  (ReportWorkerSettings / arq:reports, drains every audit +
#                     on-demand report) → report_worker_heartbeat
HC_PING_BAGENT_WORKER_HEARTBEAT=https://healthchecks.booksyaudit.pl/ping/<uuid>
HC_PING_BAGENT_REPORT_WORKER_HEARTBEAT=https://healthchecks.booksyaudit.pl/ping/<uuid>

# UWAGA — BRAK ZMIENNEJ TO CICHY NO-OP. services.healthcheck.ping czyta
# os.environ i przy pustej zmiennej po prostu nic nie robi. Cron z pingiem w
# kodzie, ale bez wpisu ponizej dopietego na tytanie, wyglada na monitorowany i
# nie jest — cisza po awarii jest nieodrozninalna od sukcesu. Kazdy slug uzyty w
# workers/ i services/ MUSI byc tutaj (pilnuje tego
# tests/test_hc_ping_env_documented.py), a przy wdrozeniu — dopiety w .env na
# tytanie, razem z checkiem zalozonym w Healthchecks.

# Per-cron checks — jeden check na zadanie, nie na proces. Ping sukcesu na
# koncu przebiegu, ping /fail w except. Grace ustawiac wg czestotliwosci crona.
#   - detekcja zmian cen konkurencji (outreach_event_detector, codziennie 5:40;
#     jeden stracony przebieg = caly dzien bez zdarzen, wiec grace ~2 h)
HC_PING_OUTREACH_PRICE_EVENTS=https://healthchecks.booksyaudit.pl/ping/<uuid>
#   - orkiestrator odswiezania scrape'ow (scrape_refresh)
HC_PING_SCRAPE_ORCHESTRATOR=https://healthchecks.booksyaudit.pl/ping/<uuid>
#   - laczenie tozsamosci pracownikow miedzy salonami (staff_identity_refresh)
HC_PING_STAFF_IDENTITY_LINKS=https://healthchecks.booksyaudit.pl/ping/<uuid>

# Crony taksonomii (workers/taxonomy_refresh.py) — kazdy etap ma wlasny check,
# bo kazdy potrafi paść osobno i z innego powodu.
#   - przeliczenie widokow taksonomii
HC_PING_TAXONOMY_VIEWS_REFRESH=https://healthchecks.booksyaudit.pl/ping/<uuid>
#   - douczanie brakujacych embeddingow taksonomii
HC_PING_TAXONOMY_EMBED_CATCHUP=https://healthchecks.booksyaudit.pl/ping/<uuid>
#   - wnioskowanie o ukrytych uslugach
HC_PING_TAXONOMY_INFERENCE_REFRESH=https://healthchecks.booksyaudit.pl/ping/<uuid>
#   - parowanie wariantow uslug
HC_PING_VARIANT_MATCH_REFRESH=https://healthchecks.booksyaudit.pl/ping/<uuid>
#   - przeliczenie profilu specjalizacji salonu
HC_PING_SALON_FOCUS_REFRESH=https://healthchecks.booksyaudit.pl/ping/<uuid>

# Sondy SLO (workers/slo_probes.py) — odpowiadaja na pytanie "czy dane naprawde
# plyna poprawnie", nie tylko "czy cron sie odpalil". Jedna sonda = jeden check.
# Procedura dodawania nowej sondy jest w naglowku workers/slo_probes.py.
HC_PING_SLO_SCRAPE_PIPELINE=https://healthchecks.booksyaudit.pl/ping/<uuid>
HC_PING_SLO_CHAIN_HEADS=https://healthchecks.booksyaudit.pl/ping/<uuid>
HC_PING_SLO_REVIEWS=https://healthchecks.booksyaudit.pl/ping/<uuid>
HC_PING_SLO_DISCOVERY=https://healthchecks.booksyaudit.pl/ping/<uuid>
HC_PING_SLO_STORAGE=https://healthchecks.booksyaudit.pl/ping/<uuid>
HC_PING_SLO_LOGFLARE=https://healthchecks.booksyaudit.pl/ping/<uuid>
HC_PING_SLO_EMBEDDING_COVERAGE=https://healthchecks.booksyaudit.pl/ping/<uuid>
HC_PING_SLO_COMPETITOR_SUBJECT_ONLY=https://healthchecks.booksyaudit.pl/ping/<uuid>
HC_PING_SLO_MONITORING_ALERTS=https://healthchecks.booksyaudit.pl/ping/<uuid>

# Brave Search API — krok „wyszukiwarka" kaskady znajdowania strony FB salonu
# (services/meta_page_discovery.py, skan reklam Ad Library). Pusty = krok pomijany,
# salony bez linku FB w Booksy i bez własnej WWW zostają bez skanu.
BRAVE_SEARCH_API_KEY=
